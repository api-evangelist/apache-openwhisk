{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache OpenWhisk REST Actions Activations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache OpenWhisk List Activations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/api/v1/namespaces/:namespace/activations",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "OpenWhisk namespace"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of activations to return"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Number of activations to skip"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Return activations since this epoch milliseconds timestamp"
              },
              {
                "name": "upto",
                "value": "",
                "type": "query",
                "description": "Return activations up to this epoch milliseconds timestamp"
              }
            ]
          },
          "docs": "List activations in the namespace."
        },
        {
          "info": {
            "name": "Apache OpenWhisk Get Activation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/api/v1/namespaces/:namespace/activations/:activationId",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "OpenWhisk namespace"
              },
              {
                "name": "activationId",
                "value": "44794bd6aab74415b4e42a308d880727",
                "type": "path",
                "description": "Activation identifier"
              }
            ]
          },
          "docs": "Get details of a specific activation."
        }
      ]
    }
  ],
  "bundled": true
}